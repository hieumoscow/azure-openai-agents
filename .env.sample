# Azure OpenAI Configuration (Direct Connection)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_ENDPOINT=https://<your-aoai>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure API Management (APIM) Connection (Alternative)
AZURE_APIM_OPENAI_SUBSCRIPTION_KEY=
AZURE_APIM_OPENAI_API_VERSION=2024-08-01-preview
AZURE_APIM_OPENAI_ENDPOINT=https://<your-apim>.azure-api.net/<suffix>/api/
AZURE_APIM_OPENAI_DEPLOYMENT=gpt-4o

# OpenAI API Key (for tracing)
OPENAI_API_KEY=

# Security Configuration - Authentication API Keys
# WARNING: Use secure, randomly generated keys in production!
ADMIN_API_KEY=admin-key-12345
TELLER_API_KEY=teller-key-12345
CUSTOMER_API_KEY=customer-key-12345

# Environment Configuration
ENVIRONMENT=development