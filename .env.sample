# Primary Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_ENDPOINT=https://<your-aoai>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Secondary Azure OpenAI Configuration (for failover)
AZURE_OPENAI_SECONDARY_ENDPOINT=https://<your-secondary-aoai>.openai.azure.com
AZURE_OPENAI_SECONDARY_KEY=
AZURE_OPENAI_SECONDARY_DEPLOYMENT=gpt-4o

# Backup Azure OpenAI Configuration
AZURE_OPENAI_BACKUP_ENDPOINT=https://<your-backup-aoai>.openai.azure.com
AZURE_OPENAI_BACKUP_KEY=
AZURE_OPENAI_BACKUP_DEPLOYMENT=gpt-4o

# Azure API Management Configuration
AZURE_APIM_OPENAI_SUBSCRIPTION_KEY=
AZURE_APIM_OPENAI_API_VERSION=2024-08-01-preview
AZURE_APIM_OPENAI_ENDPOINT=https://<your-apim>.azure-api.net/<suffix>/api/
AZURE_APIM_OPENAI_DEPLOYMENT=gpt-4o

# Secondary APIM Configuration
AZURE_APIM_SECONDARY_SUBSCRIPTION_KEY=
AZURE_APIM_SECONDARY_ENDPOINT=https://<your-secondary-apim>.azure-api.net/<suffix>/api/

# Service Discovery Configuration
SERVICE_DISCOVERY_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_FAILURE_THRESHOLD=3
HEALTH_CHECK_SUCCESS_THRESHOLD=2

# Load Balancer Configuration
LOAD_BALANCER_ALGORITHM=priority_with_fallback
LOAD_BALANCER_TIMEOUT=30
LOAD_BALANCER_MAX_RETRIES=3

# Circuit Breaker Configuration
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3

# Legacy OpenAI API Key (for compatibility)
OPENAI_API_KEY=